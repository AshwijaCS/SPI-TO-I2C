`timescale 1ns/1ps

module spi_to_i2c_top (
    input  wire clk_50mhz,
    input  wire rst_n_async,
    input  wire host_tx_req,
    
    // Bidirectional SPI physical pins
    inout  wire spi_mosi,
    inout  wire spi_miso,
    inout  wire spi_sclk,
    inout  wire spi_cs_n,
    
    // Bidirectional I2C physical pins
    inout  wire i2c_sda,
    inout  wire i2c_scl,
    
    output wire fifo_full,
    output wire fifo_empty,
    output wire parser_error
);

    // ----------------------------------------------------
    // 1. TRI-STATE SPI I/O BUFFER LOGIC
    // ----------------------------------------------------
    wire internal_mosi, internal_sclk, internal_cs_n, internal_miso;
    
    // Output Enable (OE) controls for SPI Master mode
    wire spi_mosi_oe = 1'b1; // Master actively drives MOSI
    wire spi_sclk_oe = 1'b1; // Master actively drives SCLK
    wire spi_cs_n_oe = 1'b1; // Master actively drives CS_N
    wire spi_miso_oe = 1'b0; // Master NEVER drives MISO (listens only)

    // Physical pin assignments using ternary operators (infers hardware IOBUF)
    assign spi_mosi = spi_mosi_oe ? internal_mosi : 1'bz;
    assign spi_sclk = spi_sclk_oe ? internal_sclk : 1'bz;
    assign spi_cs_n = spi_cs_n_oe ? internal_cs_n : 1'bz;
    assign spi_miso = spi_miso_oe ? 1'b0          : 1'bz; 
    
    // Internal read-back from the physical MISO pin
    assign internal_miso = spi_miso; 


    // ----------------------------------------------------
    // 2. CLOCK AND RESET GENERATION
    // ----------------------------------------------------
    wire clk_sys, clk_spi;
    
    // Assign the 50MHz system clock directly since clock_gen only divides
    assign clk_sys = clk_50mhz; 
    
    clock_gen u_clk_gen (
        .clk_50mhz   (clk_50mhz),
        .rst_n_async (rst_n_async),
        .clk_spi     (clk_spi)
    );

    wire rst_n_sys, rst_n_spi;
    
    rst_sync u_sync_sys (
        .clk       (clk_sys),
        .rst_n_in  (rst_n_async),
        .rst_n_out (rst_n_sys)
    );
    
    rst_sync u_sync_spi (
        .clk       (clk_spi),
        .rst_n_in  (rst_n_async),
        .rst_n_out (rst_n_spi)
    );


    // ----------------------------------------------------
    // 3. SPI INGRESS (MASTER RECEIVING FROM EXTERNAL SLAVE)
    // ----------------------------------------------------
    wire spi_rx_valid;
    wire [7:0] spi_rx_data;
    wire spi_tx_ready, spi_busy;

    spi_master u_spi_master (
        .clk_spi  (clk_spi),
        .rst_n    (rst_n_spi),
        .tx_data  (8'h00),         // Tied to 0; our focus is receiving MISO
        .tx_valid (host_tx_req),
        .tx_ready (spi_tx_ready),
        .rx_data  (spi_rx_data),
        .rx_valid (spi_rx_valid),
        .busy     (spi_busy),
        .spi_mosi (internal_mosi),
        .spi_miso (internal_miso),
        .spi_sclk (internal_sclk),
        .spi_cs_n (internal_cs_n)
    );


    // ----------------------------------------------------
    // 4. CLOCK DOMAIN CROSSING (FIFO)
    // ----------------------------------------------------
    wire parser_fifo_rd_en;
    wire [7:0] fifo_rd_data;

    async_fifo u_async_fifo (
        .wr_clk   (clk_spi),
        .wr_rst_n (rst_n_spi),
        .wr_en    (spi_rx_valid),
        .wr_data  (spi_rx_data),
        
        .rd_clk   (clk_sys),
        .rd_rst_n (rst_n_sys),
        .rd_en    (parser_fifo_rd_en),
        .rd_data  (fifo_rd_data),
        
        .full     (fifo_full),
        .empty    (fifo_empty)
    );


    // ----------------------------------------------------
    // 5. PACKET PARSING (FSM)
    // ----------------------------------------------------
    wire [7:0] reg_addr;
    wire [7:0] wr_data;
    wire       reg_wr_en;
    wire       reg_rd_en;
    wire [7:0] i2c_addr;
    wire [7:0] length;
    
    wire slave_busy;
    wire ack_error;

    packet_parser u_packet_parser (
        .clk_sys    (clk_sys),
        .rst_n      (rst_n_sys),
        
        .fifo_data  (fifo_rd_data),
        .fifo_empty (fifo_empty),
        .fifo_rd_en (parser_fifo_rd_en),
        
        .rd_data    (8'h00), // Hardcoded for this uni-directional test flow
        .busy       (slave_busy),
        
        .i2c_addr   (i2c_addr),
        .reg_addr   (reg_addr),
        .length     (length),
        .reg_wr_en  (reg_wr_en),
        .reg_rd_en  (reg_rd_en),
        .wr_data    (wr_data),
        .ack_error  (parser_error) 
    );


    // ----------------------------------------------------
    // 6. I2C EGRESS (SLAVE MEMORY TO EXTERNAL PINS)
    // ----------------------------------------------------
    wire [7:0] i2c_rd_data;

    i2c_slave u_i2c_slave (
        .clk_sys    (clk_sys),
        .rst_n      (rst_n_sys),
        
        .i2c_sda    (i2c_sda),
        .i2c_scl    (i2c_scl),
        
        .reg_addr   (reg_addr),
        .reg_wr_en  (reg_wr_en),
        .reg_rd_en  (reg_rd_en),
        .wr_data    (wr_data),
        .rd_data    (i2c_rd_data),
        
        .slave_busy (slave_busy),
        .ack_error  (ack_error)
    );

endmodule
