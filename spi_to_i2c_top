module spi_to_i2c_top (
    input  wire clk_50mhz,
    input  wire rst_n_async,
    input  wire host_tx_req,     // Added as real physical input port

    output wire spi_mosi,
    input  wire spi_miso,
    output wire spi_sclk,
    output wire spi_cs_n,

    inout  wire i2c_sda,
    inout  wire i2c_scl,

    output wire fifo_full,
    output wire fifo_empty,
    output wire parser_error
);

    wire clk_spi;
    clock_gen u_clk_gen (
        .clk_50mhz(clk_50mhz), 
        .rst_n_async(rst_n_async), 
        .clk_spi(clk_spi)
    );

    wire rst_n_sys, rst_n_spi;
    rst_sync u_sync_sys (.clk(clk_50mhz), .rst_n_in(rst_n_async), .rst_n_out(rst_n_sys));
    rst_sync u_sync_spi (.clk(clk_spi),   .rst_n_in(rst_n_async), .rst_n_out(rst_n_spi));

    wire [7:0] spi_rx_data;
    wire spi_rx_valid, spi_tx_ready;

    spi_master u_spi_master (
        .clk_spi(clk_spi), 
        .rst_n(rst_n_spi),
        .tx_data(8'h00), 
        .tx_valid(host_tx_req), // Connected to new top-level pin
        .tx_ready(spi_tx_ready),
        .rx_data(spi_rx_data), 
        .rx_valid(spi_rx_valid), 
        .busy(),
        .spi_mosi(spi_mosi), 
        .spi_miso(spi_miso), 
        .spi_sclk(spi_sclk), 
        .spi_cs_n(spi_cs_n)
    );

    wire [7:0] fifo_rd_data;
    wire parser_fifo_rd_en;

    async_fifo u_async_fifo (
        .wr_clk(clk_spi), 
        .wr_rst_n(rst_n_spi), 
        .wr_en(spi_rx_valid), 
        .wr_data(spi_rx_data), 
        .full(fifo_full),
        .rd_clk(clk_50mhz), 
        .rd_rst_n(rst_n_sys), 
        .rd_en(parser_fifo_rd_en), 
        .rd_data(fifo_rd_data), 
        .empty(fifo_empty)
    );

    wire [7:0] parser_i2c_addr, parser_reg_addr, parser_len, parser_wr_data, parser_rd_data;
    wire parser_wr_en, parser_rd_en, ack_err, slave_busy;

    packet_parser u_packet_parser (
        .clk_sys(clk_50mhz), 
        .rst_n(rst_n_sys),
        .fifo_data(fifo_rd_data), 
        .fifo_empty(fifo_empty), 
        .fifo_rd_en(parser_fifo_rd_en),
        .rd_data(parser_rd_data), 
        .busy(slave_busy),
        .i2c_addr(parser_i2c_addr), 
        .reg_addr(parser_reg_addr), 
        .length(parser_len),
        .reg_wr_en(parser_wr_en), 
        .reg_rd_en(parser_rd_en), 
        .wr_data(parser_wr_data), 
        .ack_error(ack_err)
    );

    wire i2c_ack_err;
    assign parser_error = ack_err | i2c_ack_err | ((parser_wr_en | parser_rd_en) & (parser_i2c_addr != 7'h50));

    i2c_slave u_i2c_slave (
        .clk_sys(clk_50mhz), 
        .rst_n(rst_n_sys),
        .i2c_sda(i2c_sda), 
        .i2c_scl(i2c_scl),
        .reg_addr(parser_reg_addr), 
        .reg_wr_en(parser_wr_en), 
        .reg_rd_en(parser_rd_en), 
        .wr_data(parser_wr_data), 
        .rd_data(parser_rd_data),
        .slave_busy(slave_busy), 
        .ack_error(i2c_ack_err)
    );

endmodule
