`timescale 1ns/1ps

module spi_to_i2c_top (
    input  wire clk_50mhz,
    input  wire rst_n_async,
    input  wire host_tx_req,
    
    // Explicit SPI Master physical pins
    output wire spi_mosi,
    input  wire spi_miso,
    output wire spi_sclk,
    output wire spi_cs_n,
    
    // Bidirectional I2C physical pins
    inout  wire i2c_sda,
    inout  wire i2c_scl,
    
    // Status Flags
    output wire fifo_full,
    output wire fifo_empty,
    output wire parser_error
);

    // ----------------------------------------------------
    // 1. CLOCK AND RESET GENERATION
    // ----------------------------------------------------
    wire clk_sys = clk_50mhz; 
    wire clk_spi;
    
    clock_gen u_clk_gen (
        .clk_50mhz   (clk_50mhz),
        .rst_n_async (rst_n_async),
        .clk_spi     (clk_spi)
    );

    wire rst_n_sys, rst_n_spi;
    
    rst_sync u_sync_sys (
        .clk       (clk_sys),
        .rst_n_in  (rst_n_async),
        .rst_n_out (rst_n_sys)
    );
    
    rst_sync u_sync_spi (
        .clk       (clk_spi),
        .rst_n_in  (rst_n_async),
        .rst_n_out (rst_n_spi)
    );

    // ----------------------------------------------------
    // 2. EDGE DETECTOR FOR ESP32 TRIGGER
    // (Prevents double-firing the SPI Master)
    // ----------------------------------------------------
    reg host_req_meta, host_req_sync, host_req_prev;
    always @(posedge clk_spi or negedge rst_n_spi) begin
        if (!rst_n_spi) begin
            host_req_meta <= 1'b0; 
            host_req_sync <= 1'b0; 
            host_req_prev <= 1'b0;
        end else begin
            host_req_meta <= host_tx_req;
            host_req_sync <= host_req_meta;
            host_req_prev <= host_req_sync;
        end
    end
    wire host_tx_req_pulse = host_req_sync & ~host_req_prev;

    // ----------------------------------------------------
    // 3. SPI INGRESS (MASTER RECEIVING FROM ESP32)
    // ----------------------------------------------------
    wire spi_rx_valid;
    wire [7:0] spi_rx_data;
    wire spi_tx_ready, spi_busy;

    spi_master u_spi_master (
        .clk_spi  (clk_spi),
        .rst_n    (rst_n_spi),
        .tx_data  (8'h00),             // Dummy byte; focus is reading MISO
        .tx_valid (host_tx_req_pulse), // Only trigger once per rising edge
        .tx_ready (spi_tx_ready),
        .rx_data  (spi_rx_data),
        .rx_valid (spi_rx_valid),
        .busy     (spi_busy),
        
        .spi_mosi (spi_mosi),
        .spi_miso (spi_miso),
        .spi_sclk (spi_sclk),
        .spi_cs_n (spi_cs_n)
    );

    // ----------------------------------------------------
    // 4. CLOCK DOMAIN CROSSING (ASYNCHRONOUS FIFO)
    // ----------------------------------------------------
    wire parser_fifo_rd_en;
    wire [7:0] fifo_rd_data;

    async_fifo u_async_fifo (
        .wr_clk   (clk_spi),
        .wr_rst_n (rst_n_spi),
        .wr_en    (spi_rx_valid),
        .wr_data  (spi_rx_data),
        
        .rd_clk   (clk_sys),
        .rd_rst_n (rst_n_sys),
        .rd_en    (parser_fifo_rd_en),
        .rd_data  (fifo_rd_data),
        
        .full     (fifo_full),
        .empty    (fifo_empty)
    );

    // ----------------------------------------------------
    // 5. PACKET PARSING (FSM)
    // ----------------------------------------------------
    wire [7:0] reg_addr;
    wire [7:0] wr_data;
    wire       reg_wr_en;
    wire       reg_rd_en;
    wire [7:0] i2c_addr;
    wire [7:0] length;
    
    wire slave_busy;
    wire i2c_ack_error;
    wire [7:0] i2c_rd_data;

    packet_parser u_packet_parser (
        .clk_sys    (clk_sys),
        .rst_n      (rst_n_sys),
        
        .fifo_data  (fifo_rd_data),
        .fifo_empty (fifo_empty),
        .fifo_rd_en (parser_fifo_rd_en),
        
        .rd_data    (i2c_rd_data),     // Links data read back from I2C Slave
        .busy       (slave_busy),      // Halts parser if I2C slave is actively processing
        
        .i2c_addr   (i2c_addr),
        .reg_addr   (reg_addr),
        .length     (length),
        .reg_wr_en  (reg_wr_en),
        .reg_rd_en  (reg_rd_en),
        .wr_data    (wr_data),
        .ack_error  (parser_error) 
    );

    // ----------------------------------------------------
    // 6. I2C EGRESS (SLAVE MEMORY TO EXTERNAL PINS)
    // ----------------------------------------------------
    i2c_slave u_i2c_slave (
        .clk_sys    (clk_sys),
        .rst_n      (rst_n_sys),
        
        .i2c_sda    (i2c_sda),
        .i2c_scl    (i2c_scl),
        
        .reg_addr   (reg_addr),
        .reg_wr_en  (reg_wr_en),
        .reg_rd_en  (reg_rd_en),
        .wr_data    (wr_data),
        .rd_data    (i2c_rd_data),
        
        .slave_busy (slave_busy),
        .ack_error  (i2c_ack_error)
    );

endmodule
